{
  "version": 2,
  "rules": [
    {
      "id": "solar_output_routing",
      "name": "Routage solaire charge SSR1",
      "enabled": true,
      "priority": 10,
      "logic": "AND",
      "conditions": [
        {
          "id": "cond_safety_ok",
          "source": "Securite",
          "measure": "safetyLevel",
          "type": "enum",
          "operator": "==",
          "value": "OK"
        }
      ],
      "actions": [
        {
          "actuatorId": "ssr1_output",
          "command": "setPowerFromSurplus",
          "regulation": "PID",
          "maxOutputPowerW": 1500,
          "pidSchema": 1,
          "pidEnabled": true,
          "pidSensorId": "grid",
          "pidMeasurement": "gridPowerW",
          "kp": 0.02,
          "ki": 0.002,
          "kd": 0,
          "gridSetpointW": 0,
          "deadbandW": 30,
          "biasPercent": 0,
          "maxPercent": 100,
          "maxOutputRampPercentPerSecond": 5,
          "maxOutputDropPercentPerSecond": 100,
          "measurementFilterMs": 0,
          "derivativeFilterMs": 500,
          "pidIntervalMs": 200,
          "measurementTimeoutMs": 5000,
          "requireProduction": false
        }
      ]
    },
    {
      "id": "temperature_safety",
      "name": "Securite temperature equipement",
      "enabled": true,
      "priority": 100,
      "logic": "OR",
      "conditions": [
        {
          "source": "sonde1",
          "measure": "temperatureC",
          "type": "number",
          "operator": ">=",
          "value": 70,
          "unit": "C"
        }
      ],
      "actions": [
        {
          "actuatorId": "ssr1_output",
          "command": "stop"
        },
        {
          "actuatorId": "ssr2_aux",
          "command": "stop"
        },
        {
          "actuatorId": "robotdyn_triac",
          "command": "stop"
        }
      ]
    }
  ]
}
